{
  "name": "presenter",
  "productName": "Presenter",
  "version": "0.1.0",
  "description": "Worship presentation software: slides to a projector or LED wall",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test.js",
    "package": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.presenter.app",
    "productName": "Presenter",
    "files": ["*.js", "*.html", "!test.js"],
    "win": { "target": "nsis" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  }
}
